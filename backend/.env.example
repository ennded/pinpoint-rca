PORT=4000

# MongoDB connection string (Atlas or local), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rootcause-ai
# mongodb://localhost:27017/rootcause-ai
MONGODB_URI=

# OpenAI API key (used for text-embedding-3-small and gpt-4o-mini)
OPENAI_API_KEY=

# GitHub token with repo/actions:read access, for fetching workflow run logs
GITHUB_TOKEN=

# Slack bot token (from a Slack app with chat:write scope, installed to your
# workspace), used to post incidents via chat.postMessage. Without it, Slack
# posts fall back to logging only.
SLACK_BOT_TOKEN=

# Signing secret from the same Slack app's "Basic Information" page, used to
# verify inbound Events API requests (thread replies like "resolved").
SLACK_SIGNING_SECRET=

# Channel to post to when the request doesn't specify one, e.g. #incidents
SLACK_DEFAULT_CHANNEL=
